<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_marginTop="10dp"
        android:layout_weight="3"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <RelativeLayout
            android:layout_marginLeft="3dp"
            android:layout_marginRight="5dp"
            android:layout_weight="3.5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/edge"
            android:gravity="center|top"
            android:orientation="vertical">

            <ImageView
                android:layout_marginRight="20dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/soil"
                android:layout_alignParentRight="true"
                android:layout_width="50dp"
                android:layout_height="40dp"/>

            <TextView
                android:layout_marginLeft="20dp"
                android:layout_alignParentTop="true"
                android:layout_width="100dp"
                android:layout_height="45dp"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="수분함량"
                android:textSize="25dp"/>

            <ProgressBar
                android:id="@+id/pr1"
                android:layout_centerInParent="true"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:indeterminate="false"
                android:max="100"
                android:min="0"
                android:progress="60"
                android:progressDrawable="@drawable/round3" />

            <TextView
                android:id="@+id/state_number1"
                android:layout_centerInParent="true"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="60%"
                android:textSize="20dp" />

            <TextView
                android:id="@+id/state1"
                android:layout_marginBottom="15dp"
                android:layout_alignParentBottom="true"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="상태: 보통"
                android:textSize="20dp" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_marginRight="3dp"
            android:layout_weight="3.5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/edge"
            android:gravity="center|top"
            android:orientation="vertical">

            <ImageView
                android:layout_marginRight="20dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/remaining"
                android:layout_alignParentRight="true"
                android:layout_width="50dp"
                android:layout_height="40dp"/>

            <TextView
                android:layout_marginLeft="30dp"
                android:layout_alignParentTop="true"
                android:layout_width="80dp"
                android:layout_height="45dp"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="물 여분"
                android:textSize="25dp"/>

            <ProgressBar
                android:id="@+id/pr2"
                android:layout_centerInParent="true"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:indeterminate="false"
                android:max="100"
                android:min="0"
                android:progress="100"
                android:progressDrawable="@drawable/round2" />

            <TextView
                android:id="@+id/state_number2"
                android:layout_centerInParent="true"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="100%"
                android:textSize="20dp" />

            <TextView
                android:id="@+id/state2"
                android:layout_marginBottom="15dp"
                android:layout_alignParentBottom="true"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="상태: 좋음"
                android:textSize="20dp" />

        </RelativeLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_marginTop="10dp"
        android:layout_weight="3"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <RelativeLayout
            android:layout_marginLeft="3dp"
            android:layout_marginRight="5dp"
            android:layout_weight="3.5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/edge"
            android:gravity="center|top"
            android:orientation="vertical">

            <ImageView
                android:layout_marginRight="30dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/temperature"
                android:layout_alignParentRight="true"
                android:layout_width="50dp"
                android:layout_height="40dp"/>

            <TextView
                android:layout_marginLeft="40dp"
                android:layout_alignParentTop="true"
                android:layout_width="60dp"
                android:layout_height="45dp"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="온도"
                android:textSize="25dp"/>

            <ProgressBar
                android:id="@+id/pr3"
                android:layout_centerInParent="true"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:indeterminate="false"
                android:max="50"
                android:min="0"
                android:progress="15"
                android:progressDrawable="@drawable/round" />

            <TextView
                android:id="@+id/state_number3"
                android:layout_centerInParent="true"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="15ºC"
                android:textSize="20dp" />

            <TextView
                android:id="@+id/state3"
                android:layout_marginBottom="15dp"
                android:layout_alignParentBottom="true"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="상태: 나쁨"
                android:textSize="20dp" />

        </RelativeLayout>

        <RelativeLayout
            android:layout_marginRight="3dp"
            android:layout_weight="3.5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/edge"
            android:gravity="center|top"
            android:orientation="vertical">

            <ImageView
                android:layout_marginRight="30dp"
                android:layout_marginTop="10dp"
                android:src="@drawable/humi"
                android:layout_alignParentRight="true"
                android:layout_width="50dp"
                android:layout_height="40dp"/>

            <TextView
                android:layout_marginLeft="40dp"
                android:layout_alignParentTop="true"
                android:layout_width="60dp"
                android:layout_height="45dp"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="습도"
                android:textSize="25dp"/>

            <ProgressBar
                android:id="@+id/pr4"
                android:layout_centerInParent="true"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:indeterminate="false"
                android:max="90"
                android:min="20"
                android:progress="30"
                android:progressDrawable="@drawable/roundred" />

            <TextView
                android:id="@+id/state_number4"
                android:layout_centerInParent="true"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="30%"
                android:textSize="20dp" />

            <TextView
                android:id="@+id/state4"
                android:layout_marginBottom="15dp"
                android:layout_alignParentBottom="true"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:gravity="center"
                android:text="상태: 나쁨"
                android:textSize="20dp" />

        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:background="@drawable/edge"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="10dp"
        android:gravity="center"
        android:layout_weight="1"
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <Button
            android:id="@+id/btn_state"
            android:textSize="18dp"
            android:textColor="@color/black"
            android:background="@android:color/transparent"
            android:layout_marginRight="10dp"
            android:text="새로고침"
            android:layout_height="match_parent"
            android:layout_width="match_parent"/>
    </LinearLayout>
</LinearLayout>